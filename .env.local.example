# Copy to .env.local and fill in. NEVER commit .env.local (it's gitignored).
# Only DATABASE_URL and AUTH_SECRET are needed for a first local run.
# Missing integration keys switch that integration off; they don't crash the site.

# --- PostgreSQL 14+ ---
DATABASE_URL=postgres://store:password@localhost:5432/store
# Max connections per app process (default 10).
# PG_POOL_MAX=10

# --- Login sessions ---
# Signs the session cookie. At least 32 random characters. Changing it logs everyone out.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# --- Public site address (sitemap, Monobank redirect + webhook URLs) ---
# Defaults to site.url in lib/site.js if unset.
SITE_URL=https://agrolab.com.ua

# --- Uploaded product photos (admin) ---
# Default: ./uploads inside the app folder. Back it up together with the database.
# UPLOAD_DIR=/var/lib/agrolab/uploads

# --- Supplier sync (docs/SUPPLIER-SYNC.md) ---
# Pull mode: the store pages through the scraper's API.
SUPPLIER_API_URL=        # agrolosk-price-service, e.g. http://127.0.0.1:8001/products
SUPPLIER_REFRESH_URL=    # optional, e.g. http://127.0.0.1:8001/sync (npm run sync:supplier -- --refresh)
SUPPLIER_API_TOKEN=
# Push mode + cron trigger: "Authorization: Bearer <secret>". At least 16 characters.
SUPPLIER_SYNC_SECRET=

# --- Monobank acquiring (online card payments): web.monobank.ua ---
MONOBANK_API_TOKEN=

# --- Nova Poshta (city/branch picker): Nova Poshta business account → API ---
NOVA_POSHTA_API_KEY=

# --- Telegram order alerts ---
# Bot token from @BotFather; chat id of the group/user that gets alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# A SECOND, separate bot and chat for technical alerts (price check, sync problems) for whoever runs the site.
# Orders go to the pair above (the person who handles customers); these two never mix.
TELEGRAM_ALERTS_BOT_TOKEN=
TELEGRAM_ALERTS_CHAT_ID=

# --- Email (password reset codes), sent through Resend ---
# API key with "Sending access". Until your domain is verified in Resend, use
# MAIL_FROM=Agrolab <onboarding@resend.dev>: it delivers only to the Resend account owner.
RESEND_API_KEY=
MAIL_FROM=Agrolab <noreply@your-domain>

# --- Google Analytics 4 measurement id (G-XXXXXXXXXX). Leave empty to disable ---
NEXT_PUBLIC_GA_ID=
# HEALTH_SYNC_MAX_AGE_HOURS=6

# --- Extra hosts whose photos may be optimized (comma separated), e.g. your own image domain; *.r2.dev is always allowed ---
# NEXT_PUBLIC_IMAGE_HOSTS=img.your-domain.com

# --- Popularity: the catalogue sorts by sales once this many orders exist ---
# POPULARITY_MIN_ORDERS=30

# --- Publish rules for supplier products (hidden when they fail) ---
# Hide products whose price is at or below this (1 ₴ is a placeholder on the supplier's site). Default 1.
# PUBLISH_MIN_PRICE=1
# Hide products without a single photo. Set to "false" to show them. Default true.
# PUBLISH_REQUIRE_IMAGE=true
