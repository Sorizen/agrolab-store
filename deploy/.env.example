# Copy to deploy/.env (never commit it). Used by docker compose itself.
DOMAIN=agrolab.com.ua
ACME_EMAIL=you@example.com

# Long random values: openssl rand -base64 24
POSTGRES_PASSWORD=
STORE_DB_PASSWORD=
PARSER_DB_PASSWORD=

# Cloudflare R2 (photos written by the parser, backups written by the backup service)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Backups go to this bucket (can be the same bucket; a private one is better) under backups/
R2_BACKUP_BUCKET=
# Optional separate key for backups; falls back to the key above
# R2_BACKUP_ACCESS_KEY_ID=
# R2_BACKUP_SECRET_ACCESS_KEY=
BACKUP_KEEP_DAYS=30

# Baked into the site at build time
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_IMAGE_HOSTS=

# Technical alerts (backup failures)
TELEGRAM_ALERTS_BOT_TOKEN=
TELEGRAM_ALERTS_CHAT_ID=

# Local trials only: HTTP_PORT=8088 HTTPS_PORT=8443 DOMAIN=localhost
