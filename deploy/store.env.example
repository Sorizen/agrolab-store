# Copy to deploy/store.env (never commit it). Runtime settings of the store container.
# DATABASE_URL, SITE_URL and the supplier URLs are set by docker-compose; do not repeat them here.
# Signs login cookies. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Parser API access, if you protected it (see the parser README); leave empty otherwise
SUPPLIER_API_TOKEN=
# Bearer secret for push/cron requests to /api/supplier/*, at least 16 characters
SUPPLIER_SYNC_SECRET=

MONOBANK_API_TOKEN=
NOVA_POSHTA_API_KEY=

# Orders and contact messages: the person who handles customers
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Technical alerts (price check, sync): whoever runs the site
TELEGRAM_ALERTS_BOT_TOKEN=
TELEGRAM_ALERTS_CHAT_ID=

# Email through Resend; the domain must be verified there
RESEND_API_KEY=
MAIL_FROM=Agrolab <noreply@agrolab.com.ua>

POPULARITY_MIN_ORDERS=30
PUBLISH_MIN_PRICE=1
PUBLISH_REQUIRE_IMAGE=true
